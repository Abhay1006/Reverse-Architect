# Port for the Express API server
PORT=4000

# Interface to bind to. Defaults to 127.0.0.1 so the API is not exposed
# directly — the Next.js server proxies to it. Set to 0.0.0.0 only if you
# intend to expose the backend and have set ALLOWED_ORIGINS below.
# HOST=127.0.0.1

# Comma-separated list of browser origins allowed to call the API directly.
# Only needed when the frontend runs with NEXT_PUBLIC_USE_PROXY=false.
# Use * to allow any origin (not recommended — this API clones repositories
# and serves file contents with no authentication).
# ALLOWED_ORIGINS=http://localhost:3000

# Number of proxies in front of this server whose X-Forwarded-For to trust.
# Without it, every request through the Next.js proxy counts as one client for
# rate limiting. Set 1 when Next.js itself sits behind Cloudflare Tunnel or
# nginx (they add the real client IP, Next.js forwards it). Leave 0 when
# Next.js is exposed directly — it does not add the caller's IP, so the header
# could be spoofed. Never set this higher than the real hop count.
# TRUST_PROXY_HOPS=0

# Path to the SQLite cache database (defaults to ~/.atlas/cache.db if not specified)
# ATLAS_DB_PATH=~/.atlas/cache.db

# Where cloned repositories and extracted uploads are kept
# ATLAS_CLONES_DIR=~/.atlas/clones

# Optional GitHub token: clones and caches private repositories, and raises the
# GitHub issues API limit for the AI assistant from 60 to 5,000 requests/hour.
# GITHUB_TOKEN=your_github_token_here

# --- Resource limits ---
# Analyses allowed to run at once. Each one spawns a language server, so
# raising this on a small host risks OOM.
# ATLAS_MAX_CONCURRENT_ANALYSES=1
# How long a queued request waits for a slot before failing (ms).
# ATLAS_QUEUE_TIMEOUT_MS=600000

# --- Clone workspace eviction ---
# Cloned repos are kept after analysis so Code Peek can read source files.
# ATLAS_CLONE_MAX_AGE_MS=86400000     # delete workspaces older than 24h
# ATLAS_CLONE_MAX_BYTES=2147483648    # total budget across all workspaces (2 GiB)
# ATLAS_CLONE_SWEEP_MS=3600000        # how often the sweep runs

# --- Upload limits ---
# A .zip may be at most 50 MB compressed; these bound what it expands to.
# ATLAS_UPLOAD_MAX_UNCOMPRESSED_BYTES=524288000   # 500 MiB
# ATLAS_UPLOAD_MAX_ENTRIES=20000

# --- AI assistant ---
# API keys are supplied per-request by the browser and never stored server-side.
# Only the model selection is configured here.
# ATLAS_OPENAI_MODEL=gpt-4o
# ATLAS_ANTHROPIC_MODEL=claude-sonnet-5-5
# ATLAS_GEMINI_MODEL=gemini-3.5-flash
# ATLAS_AI_MAX_TOKENS=8192
# ATLAS_AI_TIMEOUT_MS=120000
