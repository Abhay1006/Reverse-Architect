{
  "name": "reverse-architect",
  "version": "0.1.0",
  "description": "Architecture analysis for codebases, as a CLI and an MCP server: dependency graphs, circular imports, hotspots, coupling, possibly unused code and design patterns, each with the evidence behind it.",
  "keywords": [
    "architecture",
    "dependency-graph",
    "circular-dependencies",
    "dead-code",
    "static-analysis",
    "mcp",
    "model-context-protocol",
    "code-visualization"
  ],
  "license": "MIT",
  "author": "Abhay Pratap Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhay1006/Reverse-Architect.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/Abhay1006/Reverse-Architect#readme",
  "bugs": {
    "url": "https://github.com/Abhay1006/Reverse-Architect/issues"
  },
  "type": "module",
  "bin": {
    "reverse-architect": "dist/backend/src/cli.js"
  },
  "files": [
    "dist/backend/src/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/backend/src/server.js",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "npm run build && cp ../LICENSE LICENSE",
    "postpack": "rm -f LICENSE",
    "bench": "tsx ../bench/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "multer": "^2.1.1",
    "simple-git": "^3.36.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.1.3",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "shared": "*",
    "supertest": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.9"
  }
}
