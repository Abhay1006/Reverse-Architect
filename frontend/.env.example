# Where the Next.js proxy routes reach the Atlas backend (server-side only)
BACKEND_URL=http://localhost:4000

# Backend URL for the browser — only used when NEXT_PUBLIC_USE_PROXY=false
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Set to false to have the browser call the backend directly instead of through the Next.js proxy routes
NEXT_PUBLIC_USE_PROXY=true

# NextJS development/production server port
PORT=3000
